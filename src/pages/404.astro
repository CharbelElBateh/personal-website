---
import Base from "../layouts/Base.astro";
import SimpleHero from "../components/SimpleHero.astro";
import { system, pages } from "../lib/content";
// Edit content/system.yaml → notFound
const nf = system.notFound;
---
<Base title={nf.title} description={nf.description} pageKey="404" noindex rooted>
  <SimpleHero eyebrow={nf.eyebrow} heading={nf.heading} sub={nf.sub}>
    <ul class="lost-links stagger">
      {pages.map((p) => (
        <li><a href={p.href}><span class="greek" aria-hidden="true">{p.greek}</span>{p.label}<svg class="arrow" width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M4 14L14 4M6 4h8v8"/></svg></a></li>
      ))}
    </ul>
  </SimpleHero>
</Base>
