---
import Base from "../layouts/Base.astro";
import Marks from "../components/Marks.astro";
import { home, site, page, md, plain, personLd } from "../lib/content";
// Edit content/home.yaml

const { intro, now, recent, finale } = home;
const contactGreek = page("contact")?.greek;
const words = (line: string) => {
  const ws = line.split(/\s+/);
  return ws.map((w, i) => ({ html: md(w), o: i - (ws.length - 1) / 2 }));
};
// The scroll sequence fades the tagline in word by word; split it here so nothing shifts when scripts load.
const splitWords = (html: string) => html.replace(/(^|>)([^<]+)/g, (_, gt: string, text: string) =>
  gt + text.split(/(\s+)/).map((part) => !part ? "" : /^\s+$/.test(part) ? " " : `<span class="w" aria-hidden="true">${part}</span>`).join(""));
const arrow = '<svg class="arrow" width="16" height="12" viewBox="0 0 16 12" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M1 6h14M10 1l5 5-5 5"/></svg>';
---
<Base title={home.title} description={home.description} pageKey="home" jsonLd={[personLd()]} bodyClass={finale.show ? "is-home" : "is-home no-finale"}>
  <div slot="before" class="preloader" aria-hidden="true"><div class="preloader-mid"><div class="bar"><i></i></div><p class="label-step">Loading the engine</p></div><div class="count">000</div></div>

  {intro.show ? (
    <section class="intro is-live" aria-labelledby="intro-name">
      <div class="intro-sticky">
        <div class="intro-head">
          <p class="statement rise" set:html={md(intro.statement)} />
        </div>
        <div class="intro-stage-wrap">
          <div class="stage intro-stage" data-stage={intro.stage.preset} data-seed={intro.stage.seed}>
            <h1 class="intro-name" id="intro-name" set:html={intro.name.map(md).join("<br>")} />
            <a class="pill pill-light intro-cta" href={intro.cta.href}>{intro.cta.label} <Fragment set:html={arrow} /></a>
          </div>
        </div>
        <div class="intro-statement">
          <h2 data-words aria-label={plain(intro.tagline)} set:html={splitWords(md(intro.tagline))} />
        </div>
        <div class="intro-meter" aria-hidden="true"><i></i></div>
        <Marks caption={intro.caption} />
      </div>
    </section>
  ) : <h1 class="sr-only">{site.person.name}</h1>}

  {now.show && (
    <section class="section lift">
      <div class="wrap">
        <div class="now">
          <p class="label">{now.label}</p>
          <div>
            <p class="lede reveal" set:html={md(now.lede)} />
            {now.small && <p class="small reveal" set:html={md(now.small)} />}
          </div>
        </div>
        {now.figures.length > 0 && (
          <div class="figures stagger">
            {now.figures.map((f) => <div><div class="k">{f.k}</div><div class="v">{f.v}</div></div>)}
          </div>
        )}
      </div>
    </section>
  )}

  {recent.show && recent.cards.length > 0 && (
    <section class="section" style="padding-top:0">
      <div class="wrap">
        <div class="section-head">
          <h2 class="display section-title"><span class="line-reveal"><span>{recent.title}</span></span></h2>
          {recent.more && <a class="pill pill-light" href={recent.more.href}>{recent.more.label} <Fragment set:html={arrow} /></a>}
        </div>
        <div class="works">
          {recent.cards.map((c) => (
            <a class="work-card reveal" href={c.link}>
              <div class="media"><img data-still={c.still.preset} data-seed={c.still.seed} alt=""><span class="chip">{c.chip}</span><span class="go"><svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M4 14L14 4M6 4h8v8"/></svg></span></div>
              <div class="meta"><div><h3>{c.title}</h3><p class="sub">{c.sub}</p></div><span class="date">{c.date}</span></div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  {finale.show && (
    <section class="finale" aria-label={finale.cta.label}>
      <div class="finale-sticky">
        <canvas class="finale-canvas" aria-hidden="true"></canvas>
        <div class="finale-statement" aria-hidden="true"><p>{finale.statement.map((line) => (
          <span class="fl">{words(line).map((w, i) => <>{i > 0 && " "}<span class="w" data-o={w.o} set:html={w.html} /></>)}</span>
        ))}</p></div>
        <div class="finale-cta">
          <div class="finale-card">
            <p class="page-num">{contactGreek ? `${contactGreek} · ` : ""}{finale.eyebrow}</p>
            <h2 class="finale-title" set:html={finale.title.map(md).join("<br>")} />
            <a class="pill pill-ink" href={finale.cta.href}>{finale.cta.label} <span class="dot" aria-hidden="true"></span></a>
          </div>
        </div>
        <button class="pill pill-light finale-skip" type="button">Skip to the end <svg width="12" height="14" viewBox="0 0 12 14" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M6 1v12M1 8l5 5 5-5"/></svg></button>
        <div class="finale-cue" aria-hidden="true">
          <svg width="12" height="14" viewBox="0 0 12 14" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 1v12M1 8l5 5 5-5"/></svg>
          <span>Keep scrolling</span>
          <span class="finale-cue-track"><i></i></span>
        </div>
      </div>
    </section>
  )}
</Base>
