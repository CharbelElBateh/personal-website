---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import Listing from "../components/Listing.astro";
import ListingModals from "../components/ListingModals.astro";
import { publications, publicationsLd } from "../lib/content";
// Edit content/publications.yaml (page text) and content/publications.bib (entries)
---
<Base title={publications.title} description={publications.description} pageKey="publications" jsonLd={[publicationsLd()]} listing>
  <PageHero pageKey="publications" hero={publications.hero} />
  <Listing items={publications.items} />
  <ListingModals slot="after" items={publications.items} />
</Base>
