---
/* "Next" link at the foot of inner pages, in menu order: a path through the site. */
import { pages } from "../lib/content";

interface Props { current: string }
const { current } = Astro.props;
const inner = pages.filter((p) => p.key !== "home");
const i = inner.findIndex((p) => p.key === current);
const next = i >= 0 ? inner[i + 1] : undefined;
---
{next && (
  <nav class="next-page wrap" aria-label="Next page">
    <a href={next.href}>
      <span class="label">Next · {next.greek}</span>
      <span class="next-title">{next.label}</span>
      {next.blurb && <span class="next-blurb">{next.blurb}</span>}
      <span class="go" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 14L14 4M6 4h8v8"/></svg></span>
    </a>
  </nav>
)}
